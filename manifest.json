{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "huddo-linkedin@huddo.com",
      "strict_min_version": "128.0"
    }
  },
  "name": "Huddo LinkedIn Extension for HCL Verse",
  "version": "1.2.0",
  "description": "Look up LinkedIn profiles for email senders directly in HCL Verse — one click from any email",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "Toggle LinkedIn lookup panel"
    }
  },
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Huddo LinkedIn Extension for HCL Verse",
    "default_icon": {
      "16":  "icons/icon16.png",
      "32":  "icons/icon32.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
